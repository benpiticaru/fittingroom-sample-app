{
  "app": { "name": "sample-dispatch" },
  "muslin": {
    "aliases": { "api": { "file": "./src/api/client.ts", "to": "./src/muslin/client.ts" } },
    "descriptor": "./src/muslin/descriptor.json",
    "fixtures": "src/fixtures",
    "configSurface": "src/features/jobs/tableConfig.json",
    "overlay": "src/features/jobs/tableConfig.muslin.json",
    "screens": { "/": { "endpoints": ["jobs"] } },
    "personas": "src/fixtures/personas",
    "data": { "types": "./src/api/types.ts", "nameFields": ["customerName"] }
  },
  "attempt": {
    "delegate": false,
    "testCommand": "npx vitest run --project sample-app --exclude \"**/*replay.test.ts\" --exclude \"**/*.live.test.ts\""
  },
  "liveEdit": {
    "enabled": true,
    "protect": ["src/api/client.ts", "src/muslin/**"],
    "agentEnv": ["USER", "LOGNAME"]
  },
  "providers": { "claude": { "model": "claude-sonnet-5-5", "maxTokens": 4096 } },
  "window": { "open": false },
  "agent": "facilitator",
  "publish": { "tracker": "none" }
}

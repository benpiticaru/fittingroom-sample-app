{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Fitting",
  "definitions": {
    "Fitting": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "muslinBuild": {
          "type": "string",
          "description": "Short identifier for the muslin build, e.g. a git SHA of main."
        },
        "app": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "screen": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "screen"
          ],
          "additionalProperties": false,
          "description": "The host app this fitting ran against."
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Which synthetic fixture(s) the stakeholder worked on."
        },
        "stakeholder": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "role"
          ],
          "additionalProperties": false
        },
        "facilitator": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "description": "Who drove the session, if a developer was in the loop."
        },
        "startedAt": {
          "type": "string"
        },
        "submittedAt": {
          "type": "string"
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Pin"
          }
        },
        "transcript": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TranscriptTurn"
          },
          "description": "Full transcript, in order."
        },
        "window": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "closesAt": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "closesAt"
          ],
          "additionalProperties": false,
          "description": "Intake window this fitting belongs to."
        },
        "attempt": {
          "$ref": "#/definitions/AttemptResult",
          "description": "Latest attempt result, persisted by `recordAttempt()`. `draftAlterations()` falls back to it."
        },
        "ticket": {
          "$ref": "#/definitions/FittingTicket",
          "description": "Where the alterations were published, persisted by `recordTicket()`."
        },
        "pending": {
          "$ref": "#/definitions/Pin",
          "description": "A pin waiting on a clarification answer; not yet in `pins`."
        },
        "branch": {
          "$ref": "#/definitions/FittingBranchRef",
          "description": "The fitting branch, derived from the validated id."
        }
      },
      "required": [
        "id",
        "muslinBuild",
        "app",
        "fixtures",
        "stakeholder",
        "startedAt",
        "pins",
        "transcript"
      ],
      "additionalProperties": false
    },
    "Pin": {
      "type": "object",
      "properties": {
        "dataNeeds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Field paths the change depends on, each a `dataFields` path (core's `keepDataNeeds`).",
          "maxItems": 10
        },
        "renderGap": {
          "type": "boolean",
          "const": true,
          "description": "A data-gap pin whose stakeholder asked to see the field rendered with example values (spec Revision 11, *Live edit of a gap*)."
        },
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "utterance": {
          "type": "string",
          "description": "Stakeholder's words, verbatim, that produced this pin.",
          "pattern": "\\S"
        },
        "kind": {
          "$ref": "#/definitions/PinKind"
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "summary": {
          "type": "string",
          "description": "Human-readable summary of what changed on the screen."
        },
        "configPatch": {
          "$ref": "#/definitions/ConfigPatch",
          "description": "Machine-readable change against the app's config surface, if expressible."
        },
        "impliedField": {
          "$ref": "#/definitions/ImpliedField",
          "description": "For data-gap pins: the field the stakeholder implied."
        },
        "clarifications": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Clarification"
          },
          "description": "Questions the agent asked and whether the stakeholder answered."
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "utterance": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            },
            "required": [
              "utterance",
              "summary",
              "at"
            ],
            "additionalProperties": false
          },
          "description": "Earlier versions of this pin, if the stakeholder refined it."
        },
        "at": {
          "type": "string"
        },
        "withdrawnAt": {
          "type": "string",
          "description": "Set by `withdrawPin()`; the pin and its turns stay in the record."
        },
        "context": {
          "$ref": "#/definitions/PinContext",
          "description": "Forced by `stamp()`; never trusted from an agent."
        },
        "live": {
          "type": "boolean",
          "description": "Set from `liveness()`."
        },
        "notLiveReason": {
          "type": "string",
          "description": "Set from `liveness()`."
        },
        "liveEdit": {
          "$ref": "#/definitions/LiveEditRecord",
          "description": "Set by the server after a live edit (spec Revision 10); never trusted from an agent. A `kept` status makes the pin live."
        }
      },
      "required": [
        "id",
        "utterance",
        "kind",
        "scope",
        "summary",
        "at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "data-gap"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "const": "backend"
              },
              "impliedField": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              }
            },
            "required": [
              "impliedField"
            ]
          },
          "else": {
            "if": {
              "properties": {
                "kind": {
                  "const": "display-rule"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "scope": {
                  "enum": [
                    "frontend",
                    "backend"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "scope": {
                  "const": "frontend"
                }
              }
            }
          }
        }
      ]
    },
    "PinKind": {
      "type": "string",
      "enum": [
        "layout",
        "visibility",
        "sort",
        "filter",
        "label",
        "display-rule",
        "density",
        "data-gap"
      ],
      "description": "What kind of change a pin represents. Decides who can act on it."
    },
    "Scope": {
      "type": "string",
      "enum": [
        "frontend",
        "backend",
        "design"
      ],
      "description": "Where the change has to happen."
    },
    "ConfigPatch": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Dot path relative to the config document root, e.g. \"columnOrder\" or \"labels.status\". Arrays are replaced whole."
        },
        "before": {},
        "after": {},
        "file": {
          "type": "string",
          "description": "Source file the patch targets, when known, e.g. \"src/features/variants/tableConfig.ts\"."
        }
      },
      "required": [
        "path",
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "ImpliedField": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "description": "Mask of the gap's example values: every digit `0`, letter runs only `SYN`, all `A` or a declared prefix (`normaliseMask`).",
          "maxLength": 32,
          "pattern": "^[A-Z0_./: -]+$"
        },
        "name": {
          "type": "string",
          "description": "Suggested property name, camelCase."
        },
        "typeHint": {
          "type": "string",
          "description": "The type the stakeholder's words imply, if any."
        },
        "onType": {
          "type": "string",
          "description": "Type or record the field would hang off, e.g. \"CaseVariant\"."
        },
        "possibleSources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Candidate systems of record, if the agent could guess."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "Clarification": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "decision": {
          "type": "string",
          "description": "Decision recorded from the answer, if one was reached."
        }
      },
      "required": [
        "question"
      ],
      "additionalProperties": false
    },
    "PinContext": {
      "type": "object",
      "properties": {
        "route": {
          "type": "string"
        },
        "persona": {
          "type": "string"
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "route",
        "persona",
        "fixtures"
      ],
      "additionalProperties": false,
      "description": "Where and as whom the stakeholder was when the pin was made."
    },
    "LiveEditRecord": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/definitions/LiveEditData",
          "description": "Set when a data step wrote persona files for this edit (spec Revision 11)."
        },
        "status": {
          "$ref": "#/definitions/LiveEditStatus"
        },
        "reason": {
          "$ref": "#/definitions/LiveEditReason",
          "description": "Set when the edit was not kept or was cancelled."
        },
        "commit": {
          "type": "string",
          "description": "The `code pin-<n>:` commit, when kept."
        },
        "revertCommit": {
          "type": "string",
          "description": "The `revert pin-<n>:` commit, when reverted."
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Source paths the kept change touched, repo-relative. Listed in the alterations for review."
        },
        "question": {
          "type": "string",
          "description": "The coding agent's `QUESTION:` text, when the reason is `question`. Shown in the alterations."
        },
        "detail": {
          "type": "string",
          "description": "Scrubbed tail of the check or dev-server output. Rendered only in the PR body's collapsed section, never in the panel."
        },
        "touch": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Selectors from the touch report (`Fitting-Touch` trailers)."
        },
        "ms": {
          "type": "number",
          "description": "How long the transaction took, in milliseconds."
        }
      },
      "required": [
        "status",
        "ms"
      ],
      "additionalProperties": false,
      "description": "The live-edit record on a pin (spec Revision 10, *Record*). Written by the server from the transaction's result; never trusted from an agent (`stamp()` drops it)."
    },
    "LiveEditData": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Persona files the data step wrote, repo-relative."
        },
        "records": {
          "type": "integer",
          "description": "Records the data step added.",
          "minimum": 0
        }
      },
      "required": [
        "files",
        "records"
      ],
      "additionalProperties": false,
      "description": "Files and records a live edit's data step added (spec R11, *Repeatability and commits*)."
    },
    "LiveEditStatus": {
      "type": "string",
      "enum": [
        "kept",
        "not-kept",
        "cancelled",
        "reverted"
      ],
      "description": "What became of a pin's live edit: kept as a `code` commit, not kept, stopped, or kept and later reverted."
    },
    "LiveEditReason": {
      "type": "string",
      "enum": [
        "dev-server",
        "out-of-sync",
        "write-set",
        "too-large",
        "identifier",
        "interrupted",
        "timeout",
        "question",
        "no-change",
        "check-failed",
        "agent-error"
      ],
      "description": "Why a live edit was not kept (spec Revision 10, *The transaction*)."
    },
    "TranscriptTurn": {
      "type": "object",
      "properties": {
        "who": {
          "type": "string",
          "enum": [
            "stakeholder",
            "agent",
            "facilitator"
          ]
        },
        "text": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "pinId": {
          "type": "string",
          "description": "Pin produced by this turn, if any."
        }
      },
      "required": [
        "who",
        "text",
        "at"
      ],
      "additionalProperties": false
    },
    "AttemptResult": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "pr-opened"
            },
            "branch": {
              "type": "string"
            },
            "prUrl": {
              "type": "string"
            },
            "filesChanged": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "testsUpdated": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            },
            "fittingBranch": {
              "$ref": "#/definitions/FittingBranchRef",
              "description": "Branch an attempt created; `recordAttempt()` copies it onto `Fitting.branch`."
            }
          },
          "required": [
            "outcome",
            "branch",
            "filesChanged",
            "testsUpdated"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "stopped"
            },
            "branch": {
              "type": "string"
            },
            "appliedPinIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blockedOn": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ImpliedField"
                },
                {
                  "type": "object",
                  "properties": {
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "reason"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "question": {
              "type": "string"
            },
            "routeTo": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blockedPinIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Every blocking pin id, in precedence order (data-gap, backend, design, needs-code)."
            },
            "fittingBranch": {
              "$ref": "#/definitions/FittingBranchRef",
              "description": "Branch an attempt created; `recordAttempt()` copies it onto `Fitting.branch`."
            }
          },
          "required": [
            "outcome",
            "branch",
            "appliedPinIds",
            "blockedOn",
            "question",
            "routeTo"
          ],
          "additionalProperties": false
        }
      ],
      "description": "What the agent produced when it tried to implement the pins on the real repo."
    },
    "FittingBranchRef": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "worktree": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "base",
        "worktree"
      ],
      "additionalProperties": false,
      "description": "The git branch and worktree a fitting works on."
    },
    "FittingTicket": {
      "type": "object",
      "properties": {
        "tracker": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FittingTicketChild"
          },
          "description": "Child issues, in creation order. Absent when the tracker filed a single issue."
        }
      },
      "required": [
        "tracker",
        "url"
      ],
      "additionalProperties": false,
      "description": "A published ticket for a fitting, e.g. `{ tracker: \"github\", url, id }` or a Jira parent with `children`."
    },
    "FittingTicketChild": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "route",
            "pin"
          ],
          "description": "`route`: one per scope present; `pin`: one per pin."
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "pinId": {
          "type": "string",
          "description": "Set when `role` is `pin`."
        },
        "id": {
          "type": "string",
          "description": "Tracker key, e.g. `SYN-2`."
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "scope",
        "id",
        "url"
      ],
      "additionalProperties": false,
      "description": "A child issue filed under a fitting's parent ticket (Jira granularity `fitting+routes` or `pins`)."
    }
  }
}
